{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 8, "height": 6,
      "properties": {
        "title": "EC2 CPU Utilization (%)",
        "metrics": [["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", "${ASG_NAME}", {"stat": "Average", "color": "#2196F3"}]],
        "period": 300,
        "yAxis": {"left": {"min": 0, "max": 100}},
        "annotations": {"horizontal": [{"value": 65, "label": "Scale-out threshold", "color": "#FF9800"}]},
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 8, "y": 0, "width": 8, "height": 6,
      "properties": {
        "title": "ALB Request Count (per 5 min)",
        "metrics": [["AWS/ApplicationELB", "RequestCount", "LoadBalancer", "${ALB_ARN_SUFFIX}", {"stat": "Sum", "color": "#4CAF50"}]],
        "period": 300,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 16, "y": 0, "width": 8, "height": 6,
      "properties": {
        "title": "ASG Instance Count",
        "metrics": [
          ["AWS/AutoScaling", "GroupDesiredCapacity",  "AutoScalingGroupName", "${ASG_NAME}", {"label": "Desired",  "color": "#2196F3"}],
          ["AWS/AutoScaling", "GroupInServiceCapacity", "AutoScalingGroupName", "${ASG_NAME}", {"label": "In Service","color": "#4CAF50"}]
        ],
        "period": 60,
        "yAxis": {"left": {"min": 0}},
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 8, "height": 6,
      "properties": {
        "title": "ALB 5XX Error Rate",
        "metrics": [
          ["AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "LoadBalancer", "${ALB_ARN_SUFFIX}", {"stat": "Sum", "color": "#F44336"}],
          ["AWS/ApplicationELB", "HTTPCode_Target_4XX_Count", "LoadBalancer", "${ALB_ARN_SUFFIX}", {"stat": "Sum", "color": "#FF9800"}]
        ],
        "period": 60,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 8, "y": 6, "width": 8, "height": 6,
      "properties": {
        "title": "ALB Response Time (P95 ms)",
        "metrics": [["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "${ALB_ARN_SUFFIX}", {"stat": "p95", "color": "#9C27B0"}]],
        "period": 60,
        "yAxis": {"left": {"min": 0}},
        "annotations": {"horizontal": [{"value": 0.5, "label": "500ms SLA", "color": "#F44336"}]},
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 16, "y": 6, "width": 8, "height": 6,
      "properties": {
        "title": "RDS DB Connections & CPU",
        "metrics": [
          ["AWS/RDS", "DatabaseConnections", "DBInstanceIdentifier", "${RDS_ID}", {"stat": "Average", "color": "#FF5722", "yAxis": "left"}],
          ["AWS/RDS", "CPUUtilization",      "DBInstanceIdentifier", "${RDS_ID}", {"stat": "Average", "color": "#795548", "yAxis": "right"}]
        ],
        "period": 60,
        "view": "timeSeries"
      }
    },
    {
      "type": "alarm",
      "x": 0, "y": 12, "width": 24, "height": 4,
      "properties": {
        "title": "Active Alarms",
        "alarms": [
          "arn:aws:cloudwatch:${REGION}:${ACCOUNT_ID}:alarm:smart-ecommerce-high-cpu",
          "arn:aws:cloudwatch:${REGION}:${ACCOUNT_ID}:alarm:smart-ecommerce-high-5xx"
        ]
      }
    }
  ]
}
